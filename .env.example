# === 服务器 ===
NODE_ENV=development
PORT=3001

# === JWT ===
JWT_SECRET=change-me-to-a-random-string-at-least-32-bytes
JWT_EXPIRES_IN=2h

# === 加密 ===
ENCRYPTION_SECRET=a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6

# === 数据库 ===
DB_HOST=localhost
DB_PORT=3306
DB_USER=bastion
DB_PASSWORD=bastion123
DB_NAME=bastion_host

# === Guacamole (RDP) ===
GUACD_HOST=localhost
GUACD_PORT=4822

# === 日志 ===
LOG_LEVEL=debug

# === 会话 ===
SESSION_IDLE_TIMEOUT=900
SESSION_MAX_DURATION=28800
MAX_SESSIONS_PER_USER=5

# === 安全 ===
# 仅在 HTTPS 反向代理后启用（纯 HTTP / 局域网 IP 访问请保持关闭）
# ENABLE_HSTS=1
LOGIN_MAX_FAILS=5
LOGIN_LOCK_MINUTES=15
PASSWORD_MIN_LENGTH=8
PASSWORD_EXPIRE_DAYS=90

# === 保留策略 ===
COMMAND_LOG_RETENTION_DAYS=90
AUDIT_LOG_RETENTION_DAYS=365
SESSION_RETENTION_DAYS=90
